{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "tests/**/*.test.{mjs,ts}"],
      "project": ["scripts/**/*.mjs", "tests/**/*.{mjs,ts}"]
    },
    "packages/ruvyxa": {
      "entry": ["runtime/*.mjs"]
    },
    "examples/demo": {
      "entry": ["ruvyxa.config.ts", "instrumentation.ts", "app/**/*.{ts,tsx}", "plugins/**/*.ts"],
      "project": ["**/*.{ts,tsx}"]
    },
    "examples/deploy-smoke": {
      "entry": ["ruvyxa.config.ts", "app/**/*.{ts,tsx}"],
      "project": ["**/*.{ts,tsx}"]
    }
  },
  "ignoreDependencies": [
    "@ruvyxa/adapter-.*",
    "@ruvyxa/react",
    "oxc-transform",
    "react-server-dom-webpack"
  ],
  "ignoreBinaries": ["pwsh", "readelf"],
  "tags": ["-@public"],
  "exclude": ["duplicates", "optionalPeerDependencies"]
}
