{
  "name": "ruvyxa",
  "version": "1.1.4",
  "description": "The Ruvyxa CLI and runtime for building, validating, serving, and shipping production-minded web applications.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "bin": {
    "ruvyxa": "./bin/ruvyxa.js"
  },
  "files": [
    "README.md",
    "bin",
    "dist",
    "native-bin",
    "runtime/action-runtime.mjs",
    "runtime/adapter-runner.mjs",
    "runtime/api-methods.mjs",
    "runtime/api-renderer.mjs",
    "runtime/cache-budget.mjs",
    "runtime/client-references.mjs",
    "runtime/compiler.mjs",
    "runtime/config-renderer.mjs",
    "runtime/config-schema.mjs",
    "runtime/css-runner.mjs",
    "runtime/entry-templates.mjs",
    "runtime/flight.mjs",
    "runtime/glob.mjs",
    "runtime/order.mjs",
    "runtime/origin-policy.mjs",
    "runtime/package-exports.mjs",
    "runtime/paths.mjs",
    "runtime/plugin-http.mjs",
    "runtime/plugin-registration.mjs",
    "runtime/plugin-runtime.mjs",
    "runtime/react-compiler.mjs",
    "runtime/request-context.mjs",
    "runtime/route-intercepts.mjs",
    "runtime/route-match.mjs",
    "runtime/rsc-client-install.mjs",
    "runtime/rsc-client-runtime.mjs",
    "runtime/scanner.mjs",
    "runtime/server-components.mjs",
    "runtime/serverless-handler.mjs",
    "runtime/ssr-renderer.mjs",
    "runtime/worker-admission.mjs",
    "runtime/worker-pool.mjs",
    "scripts/native-platform.mjs",
    "src",
    "types"
  ],
  "keywords": [
    "ruvyxa",
    "framework",
    "web-framework",
    "fullstack",
    "fullstack-framework",
    "react",
    "react-framework",
    "typescript",
    "rust",
    "ssr",
    "server-side-rendering",
    "ssg",
    "static-site-generator",
    "isr",
    "rsc",
    "react-server-components",
    "server-components",
    "streaming",
    "hydration",
    "routing",
    "file-based-routing",
    "bundler",
    "compiler",
    "build-tool",
    "dev-server",
    "hmr",
    "hot-reload",
    "cli",
    "zero-config",
    "jsx",
    "tsx",
    "middleware",
    "typescript-plugin",
    "api-routes",
    "edge",
    "serverless",
    "seo",
    "mdx",
    "markdown",
    "content-collections",
    "i18n",
    "postcss",
    "jamstack",
    "csr",
    "ppr",
    "partial-prerendering",
    "css-modules",
    "scss",
    "sass"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirawat27/Ruvyxa.git",
    "directory": "packages/ruvyxa"
  },
  "bugs": {
    "url": "https://github.com/thirawat27/Ruvyxa/issues"
  },
  "homepage": "https://github.com/thirawat27/Ruvyxa#readme",
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "default": "./dist/server.js"
    },
    "./config": {
      "types": "./types/config.d.ts",
      "default": "./dist/config.js"
    },
    "./plugin": {
      "types": "./types/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./plugins": {
      "types": "./types/plugins.d.ts",
      "default": "./dist/plugins.js"
    },
    "./plugin-harness": {
      "types": "./types/plugin-harness.d.ts",
      "default": "./dist/plugin-harness.js"
    }
  },
  "dependencies": {
    "@babel/core": "^8.0.1",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@mdx-js/mdx": "^3.1.1",
    "@ruvyxa/adapter-aws": "workspace:^",
    "@ruvyxa/adapter-bun": "workspace:^",
    "@ruvyxa/adapter-deno": "workspace:^",
    "@ruvyxa/adapter-cloudflare": "workspace:^",
    "@ruvyxa/adapter-firebase": "workspace:^",
    "@ruvyxa/adapter-netlify": "workspace:^",
    "@ruvyxa/adapter-node": "workspace:^",
    "@ruvyxa/adapter-railway": "workspace:^",
    "@ruvyxa/adapter-render": "workspace:^",
    "@ruvyxa/adapter-static": "workspace:^",
    "@ruvyxa/adapter-vercel": "workspace:^",
    "@ruvyxa/core": "workspace:^",
    "@ruvyxa/react": "workspace:^",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxc-transform": "0.147.0",
    "remark-gfm": "^4.0.1",
    "sass": "^1.103.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8"
  },
  "peerDependenciesMeta": {
    "react-server-dom-webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  },
  "optionalDependencies": {
    "@ruvyxa/cli-darwin-arm64": "workspace:*",
    "@ruvyxa/cli-linux-arm64": "workspace:*",
    "@ruvyxa/cli-linux-x64": "workspace:*",
    "@ruvyxa/cli-win32-arm64": "workspace:*",
    "@ruvyxa/cli-win32-x64": "workspace:*"
  },
  "scripts": {
    "build": "node scripts/sync-shared-runtime.mjs --check && tsc -p tsconfig.json",
    "sync:runtime": "node scripts/sync-shared-runtime.mjs",
    "check": "tsc -p tsconfig.check.json",
    "test": "pnpm run build && node --test --test-timeout=300000 \"../../tests/packages/ruvyxa/**/*.test.mjs\"",
    "format": "tsc -p tsconfig.check.json",
    "prepack": "pnpm run build && node scripts/prepare-native-binary.mjs"
  }
}
