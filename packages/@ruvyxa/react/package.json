{
  "name": "@ruvyxa/react",
  "version": "1.0.32",
  "description": "React integration for Ruvyxa apps, built for SSR-first pages and browser hydration without framework noise.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md"],
  "keywords": [
    "ruvyxa",
    "react",
    "reactjs",
    "react-framework",
    "ssr",
    "server-side-rendering",
    "ssg",
    "rsc",
    "react-server-components",
    "server-components",
    "hydration",
    "jsx",
    "tsx",
    "components",
    "hooks",
    "router",
    "routing",
    "link",
    "image",
    "seo",
    "meta-tags",
    "head",
    "error-boundary",
    "progressive-enhancement",
    "framework",
    "web-framework",
    "fullstack",
    "typescript",
    "json-ld",
    "prefetch",
    "image-optimization",
    "webp",
    "view-transitions",
    "open-graph",
    "schema-org"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirawat27/Ruvyxa.git",
    "directory": "packages/@ruvyxa/react"
  },
  "bugs": {
    "url": "https://github.com/thirawat27/Ruvyxa/issues"
  },
  "homepage": "https://github.com/thirawat27/Ruvyxa#readme",
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./routes": {
      "types": "./dist/route-types.d.ts",
      "default": "./dist/route-types.js"
    }
  },
  "dependencies": {
    "@ruvyxa/core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test \"test/**/*.test.mjs\"",
    "format": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run build"
  }
}
