{
  "name": "@ruvyxa/realtime",
  "version": "1.0.32",
  "description": "Native WebSocket realtime and collaboration rooms for self-hosted Ruvyxa applications.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md"],
  "keywords": [
    "ruvyxa",
    "realtime",
    "real-time",
    "websocket",
    "websockets",
    "ws",
    "socket",
    "live",
    "live-updates",
    "pubsub",
    "subscriptions",
    "channels",
    "rooms",
    "presence",
    "collaboration",
    "collaborative",
    "collaborative-editing",
    "crdt",
    "cursors",
    "events",
    "server-actions",
    "streaming",
    "self-hosted",
    "backend",
    "server",
    "typescript",
    "fullstack",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirawat27/ruvyxa.git",
    "directory": "packages/@ruvyxa/realtime"
  },
  "bugs": {
    "url": "https://github.com/thirawat27/ruvyxa/issues"
  },
  "homepage": "https://github.com/thirawat27/ruvyxa#readme",
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./collab": {
      "types": "./dist/collab.d.ts",
      "default": "./dist/collab.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "dependencies": {
    "@ruvyxa/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "^19.2.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "pnpm run build && node ../../../scripts/test-package.mjs realtime",
    "format": "tsc -p tsconfig.check.json",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
