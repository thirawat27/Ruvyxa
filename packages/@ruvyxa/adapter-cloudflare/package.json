{
  "name": "@ruvyxa/adapter-cloudflare",
  "version": "1.1.5",
  "description": "Shape Ruvyxa builds for Cloudflare edge targets with typed worker and asset output metadata.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md"],
  "keywords": [
    "ruvyxa",
    "adapter",
    "deploy",
    "deployment",
    "hosting",
    "build",
    "cloudflare",
    "cloudflare-workers",
    "workers",
    "worker",
    "wrangler",
    "edge",
    "edge-runtime",
    "edge-computing",
    "serverless",
    "cdn",
    "prerender",
    "ssr",
    "ssg",
    "static-assets",
    "typescript",
    "fullstack",
    "framework",
    "csr"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirawat27/Ruvyxa.git",
    "directory": "packages/@ruvyxa/adapter-cloudflare"
  },
  "bugs": {
    "url": "https://github.com/thirawat27/Ruvyxa/issues"
  },
  "homepage": "https://github.com/thirawat27/Ruvyxa#readme",
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ruvyxa/core": "workspace:^"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "pnpm run build && node ../../../scripts/test-package.mjs adapter-cloudflare",
    "format": "tsc -p tsconfig.check.json",
    "prepack": "pnpm run build"
  }
}
