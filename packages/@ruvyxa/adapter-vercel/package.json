{
  "name": "@ruvyxa/adapter-vercel",
  "version": "1.1.4",
  "description": "Shape Ruvyxa builds for Vercel-style serverless deployments with typed output metadata.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md"],
  "keywords": [
    "ruvyxa",
    "adapter",
    "deploy",
    "deployment",
    "hosting",
    "build",
    "vercel",
    "vercel-deploy",
    "serverless",
    "serverless-functions",
    "functions",
    "edge",
    "edge-functions",
    "cdn",
    "cloud",
    "prerender",
    "ssr",
    "ssg",
    "isr",
    "static-assets",
    "typescript",
    "fullstack",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirawat27/Ruvyxa.git",
    "directory": "packages/@ruvyxa/adapter-vercel"
  },
  "bugs": {
    "url": "https://github.com/thirawat27/Ruvyxa/issues"
  },
  "homepage": "https://github.com/thirawat27/Ruvyxa#readme",
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ruvyxa/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "pnpm run build && node ../../../scripts/test-package.mjs adapter-vercel",
    "format": "tsc -p tsconfig.check.json",
    "prepack": "pnpm run build"
  }
}
