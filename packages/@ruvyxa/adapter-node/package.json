{
  "name": "@ruvyxa/adapter-node",
  "version": "1.1.0",
  "description": "Run Ruvyxa on Node with a clean adapter contract for server output, assets, and production runtime metadata.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md"],
  "keywords": [
    "ruvyxa",
    "adapter",
    "deploy",
    "deployment",
    "hosting",
    "build",
    "node",
    "nodejs",
    "node-server",
    "self-hosted",
    "self-hosting",
    "server",
    "http-server",
    "standalone",
    "production",
    "pm2",
    "systemd",
    "prerender",
    "ssr",
    "ssg",
    "isr",
    "static-assets",
    "typescript",
    "fullstack",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirawat27/Ruvyxa.git",
    "directory": "packages/@ruvyxa/adapter-node"
  },
  "bugs": {
    "url": "https://github.com/thirawat27/Ruvyxa/issues"
  },
  "homepage": "https://github.com/thirawat27/Ruvyxa#readme",
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ruvyxa/core": "workspace:^"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "pnpm run build && node ../../../scripts/test-package.mjs adapter-node",
    "format": "tsc -p tsconfig.check.json",
    "prepack": "pnpm run build"
  }
}
