{
  "name": "@ruvyxa/adapter-netlify",
  "version": "1.1.3",
  "description": "Shape Ruvyxa builds for Netlify functions and assets with a small typed adapter contract.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md"],
  "keywords": [
    "ruvyxa",
    "adapter",
    "deploy",
    "deployment",
    "hosting",
    "build",
    "netlify",
    "netlify-functions",
    "functions",
    "serverless",
    "serverless-functions",
    "jamstack",
    "cdn",
    "prerender",
    "ssr",
    "ssg",
    "isr",
    "static-assets",
    "typescript",
    "fullstack",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirawat27/Ruvyxa.git",
    "directory": "packages/@ruvyxa/adapter-netlify"
  },
  "bugs": {
    "url": "https://github.com/thirawat27/Ruvyxa/issues"
  },
  "homepage": "https://github.com/thirawat27/Ruvyxa#readme",
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ruvyxa/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "pnpm run build && node ../../../scripts/test-package.mjs adapter-netlify",
    "format": "tsc -p tsconfig.check.json",
    "prepack": "pnpm run build"
  }
}
