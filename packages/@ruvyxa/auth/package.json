{
  "name": "@ruvyxa/auth",
  "version": "1.0.32",
  "description": "Secure sessions and provider-driven authentication for Ruvyxa applications.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md"],
  "keywords": [
    "ruvyxa",
    "auth",
    "authentication",
    "authorization",
    "oauth",
    "oauth2",
    "magic-link",
    "passwordless",
    "webauthn",
    "session",
    "sessions",
    "cookies",
    "login",
    "sign-in",
    "credentials",
    "providers",
    "google",
    "github",
    "security",
    "middleware",
    "server-actions",
    "typescript",
    "fullstack",
    "framework",
    "pkce",
    "logout",
    "refresh-token",
    "scopes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirawat27/ruvyxa.git",
    "directory": "packages/@ruvyxa/auth"
  },
  "bugs": {
    "url": "https://github.com/thirawat27/ruvyxa/issues"
  },
  "homepage": "https://github.com/thirawat27/ruvyxa#readme",
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "dependencies": {
    "@ruvyxa/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "pnpm run build && node ../../../scripts/test-package.mjs auth",
    "format": "tsc -p tsconfig.check.json",
    "prepack": "pnpm run build"
  }
}
