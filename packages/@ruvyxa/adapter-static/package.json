{
  "name": "@ruvyxa/adapter-static",
  "version": "1.1.0",
  "description": "Prepare Ruvyxa routes and assets for static output targets through the first-party adapter contract.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md"],
  "keywords": [
    "ruvyxa",
    "adapter",
    "deploy",
    "deployment",
    "hosting",
    "build",
    "static",
    "static-site",
    "static-site-generator",
    "prerender",
    "prerendering",
    "jamstack",
    "static-hosting",
    "cdn",
    "html",
    "ssg",
    "static-assets",
    "typescript",
    "fullstack",
    "framework",
    "csr",
    "github-pages",
    "s3"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirawat27/Ruvyxa.git",
    "directory": "packages/@ruvyxa/adapter-static"
  },
  "bugs": {
    "url": "https://github.com/thirawat27/Ruvyxa/issues"
  },
  "homepage": "https://github.com/thirawat27/Ruvyxa#readme",
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ruvyxa/core": "workspace:^"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "pnpm run build && node ../../../scripts/test-package.mjs adapter-static",
    "format": "tsc -p tsconfig.check.json",
    "prepack": "pnpm run build"
  }
}
