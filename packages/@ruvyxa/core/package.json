{
  "name": "@ruvyxa/core",
  "version": "1.1.5",
  "description": "Tiny typed primitives behind Ruvyxa: config, loaders, actions, cache helpers, responses, and adapter contracts.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md"],
  "keywords": [
    "ruvyxa",
    "core",
    "framework",
    "web-framework",
    "fullstack",
    "typescript",
    "type-safe",
    "types",
    "primitives",
    "config",
    "configuration",
    "loader",
    "loaders",
    "data-loading",
    "server-actions",
    "actions",
    "cache",
    "caching",
    "revalidation",
    "response",
    "adapter",
    "adapter-contract",
    "plugin",
    "plugins",
    "plugin-system",
    "routing",
    "route-matching",
    "runtime",
    "ssr",
    "ssg",
    "isr"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirawat27/Ruvyxa.git",
    "directory": "packages/@ruvyxa/core"
  },
  "bugs": {
    "url": "https://github.com/thirawat27/Ruvyxa/issues"
  },
  "homepage": "https://github.com/thirawat27/Ruvyxa#readme",
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./plugin-harness": {
      "types": "./dist/plugin-harness.d.ts",
      "default": "./dist/plugin-harness.js"
    },
    "./origin-policy": {
      "types": "./dist/origin-policy.d.ts",
      "default": "./dist/origin-policy.js"
    },
    "./plugin-registration": {
      "types": "./dist/plugin-registration.d.ts",
      "default": "./dist/plugin-registration.js"
    },
    "./route-match": {
      "types": "./dist/route-match.d.ts",
      "default": "./dist/route-match.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node ../../../scripts/test-package.mjs core",
    "format": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run build"
  }
}
