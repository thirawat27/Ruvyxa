{
  "name": "@ruvyxa/database",
  "version": "1.1.0",
  "description": "Typed database primitives and production adapter contracts for Ruvyxa applications.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md"],
  "keywords": [
    "ruvyxa",
    "database",
    "db",
    "prisma",
    "postgresql",
    "postgres",
    "mysql",
    "sqlite",
    "mongodb",
    "dynamodb",
    "sql",
    "nosql",
    "query",
    "queries",
    "transactions",
    "adapter",
    "adapters",
    "drivers",
    "data",
    "persistence",
    "backend",
    "server",
    "type-safe",
    "typescript",
    "fullstack",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirawat27/Ruvyxa.git",
    "directory": "packages/@ruvyxa/database"
  },
  "bugs": {
    "url": "https://github.com/thirawat27/Ruvyxa/issues"
  },
  "homepage": "https://github.com/thirawat27/Ruvyxa#readme",
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    }
  },
  "dependencies": {
    "@ruvyxa/core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "pnpm run build && node ../../../scripts/test-package.mjs database",
    "format": "tsc -p tsconfig.check.json",
    "prepack": "pnpm run build"
  }
}
