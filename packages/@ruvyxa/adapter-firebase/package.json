{
  "name": "@ruvyxa/adapter-firebase",
  "version": "1.1.4",
  "description": "Deploy full-stack Ruvyxa applications to Firebase Hosting with CDN assets and a generated Cloud Functions v2 backend.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md"],
  "keywords": [
    "ruvyxa",
    "adapter",
    "deploy",
    "deployment",
    "hosting",
    "build",
    "firebase",
    "firebase-hosting",
    "google",
    "google-cloud",
    "gcp",
    "cloud-functions",
    "cloud-functions-v2",
    "functions",
    "serverless",
    "cdn",
    "static-hosting",
    "prerender",
    "ssr",
    "ssg",
    "isr",
    "static-assets",
    "typescript",
    "fullstack",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirawat27/Ruvyxa.git",
    "directory": "packages/@ruvyxa/adapter-firebase"
  },
  "bugs": {
    "url": "https://github.com/thirawat27/Ruvyxa/issues"
  },
  "homepage": "https://github.com/thirawat27/Ruvyxa#readme",
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ruvyxa/core": "workspace:^"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.check.json",
    "test": "pnpm run build && node ../../../scripts/test-package.mjs adapter-firebase",
    "format": "tsc -p tsconfig.check.json",
    "prepack": "pnpm run build"
  }
}
