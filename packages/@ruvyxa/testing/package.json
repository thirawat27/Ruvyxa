{
  "name": "@ruvyxa/testing",
  "version": "1.1.5",
  "description": "Framework-native loader, action, and cache test doubles for Ruvyxa applications.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md"],
  "keywords": [
    "ruvyxa",
    "testing",
    "test",
    "tests",
    "test-utils",
    "vitest",
    "jest",
    "unit-testing",
    "mock",
    "mocks",
    "mocking",
    "test-doubles",
    "loaders",
    "server-actions",
    "cache",
    "tdd",
    "developer-tools",
    "typescript",
    "fullstack",
    "framework"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thirawat27/Ruvyxa.git",
    "directory": "packages/@ruvyxa/testing"
  },
  "bugs": {
    "url": "https://github.com/thirawat27/Ruvyxa/issues"
  },
  "homepage": "https://github.com/thirawat27/Ruvyxa#readme",
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@ruvyxa/core": "workspace:^"
  },
  "devDependencies": {
    "@ruvyxa/core": "workspace:^"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test \"test/**/*.test.mjs\"",
    "format": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm run build"
  }
}
